# /etc/nginx/sites-available/challenge2.rohaizat.cloud
# CikguAI - Gamuda hackathon Challenge 2. Node app on 127.0.0.1:3400 (systemd: cikguai.service).
# The SSL lines are added by `certbot --nginx -d challenge2.rohaizat.cloud`.
server {
    server_name challenge2.rohaizat.cloud;

    listen 80;
    listen [::]:80;

    client_max_body_size 8m;

    # Tutor replies stream token by token; don't buffer them.
    location = /api/tutor {
        proxy_pass http://127.0.0.1:3400;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_request_buffering on;
        proxy_read_timeout 180s;
    }

    location / {
        proxy_pass http://127.0.0.1:3400;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Lesson plans and worksheets can take up to ~2.5 minutes to generate.
        proxy_read_timeout 180s;
    }
}
